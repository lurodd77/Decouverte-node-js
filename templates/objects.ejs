<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pokedex</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/public/style.css">
</head>

<body class="pokedex-bg">

<%- include('partials/header') %>

<div class="container my-5">
  <div class="catalog-shell">
    <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
      <div>
        <p class="catalog-kicker mb-2">Catalogue Pokemon</p>
        <h1 class="mb-1">Pokedex</h1>
        <div class="text-muted">Resultats : <strong><%= total %></strong></div>
      </div>

      <div class="view-switch" role="group" aria-label="Choix de vue">
        <button type="button" class="btn <%= view === 'gallery' ? 'btn-primary' : 'btn-outline-primary' %>" onclick="setView('gallery')">Galerie</button>
        <button type="button" class="btn <%= view === 'list' ? 'btn-primary' : 'btn-outline-primary' %>" onclick="setView('list')">Liste</button>
      </div>
    </div>

    <form id="searchForm" class="row g-3 mb-4 align-items-center catalog-toolbar">
      <div class="col-lg-5">
        <input
          type="text"
          id="searchInput"
          name="search"
          class="form-control"
          placeholder="Rechercher un Pokemon..."
          value="<%= search %>"
          autocomplete="off"
        >
      </div>

      <div class="col-lg-7 d-flex flex-wrap gap-2">
        <input type="hidden" name="sort" id="sortInput" value="<%= sort %>">
        <input type="hidden" name="page" value="1">
        <input type="hidden" name="view" id="viewInput" value="<%= view %>">

        <button type="button" class="btn btn-outline-secondary sort-btn <%= sort === 'id-asc' ? 'active' : '' %>" onclick="setSort('id-asc')"># croissant</button>
        <button type="button" class="btn btn-outline-secondary sort-btn <%= sort === 'id-desc' ? 'active' : '' %>" onclick="setSort('id-desc')"># decroissant</button>
        <button type="button" class="btn btn-outline-secondary sort-btn <%= sort === 'name-asc' ? 'active' : '' %>" onclick="setSort('name-asc')">A a Z</button>
        <button type="button" class="btn btn-outline-secondary sort-btn <%= sort === 'name-desc' ? 'active' : '' %>" onclick="setSort('name-desc')">Z a A</button>
      </div>
    </form>

    <% if (view === 'gallery') { %>
      <div class="row" id="pokemonGrid">
        <% pokemons.forEach(pokemon => { %>
          <div class="col-6 col-md-4 col-xl-3 mb-4">
            <article class="card text-center shadow-sm h-100 card-hover pokemon-grid-card">
              <div class="pt-4">
                <img src="<%= pokemon.image %>" alt="<%= pokemon.name %>" width="120" height="120" loading="lazy">
              </div>
              <div class="card-body d-flex flex-column">
                <div class="text-muted small mb-2">#<%= pokemon.id %></div>
                <h5 class="card-title text-capitalize mb-3"><%= pokemon.name %></h5>
                <a href="/objets/<%= pokemon.id %>" class="btn btn-outline-primary btn-sm w-100 mt-auto">Voir le detail</a>
              </div>
            </article>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="list-view">
        <% pokemons.forEach(pokemon => { %>
          <a class="list-card" href="/objets/<%= pokemon.id %>">
            <div class="list-card__left">
              <img src="<%= pokemon.image %>" alt="<%= pokemon.name %>" width="88" height="88" loading="lazy">
              <div>
                <div class="text-muted small mb-1">Pokemon #<%= pokemon.id %></div>
                <h2 class="h5 text-capitalize mb-2"><%= pokemon.name %></h2>
                <p class="mb-0 text-muted">Ouvre la fiche complete pour voir ses evolutions, capacites et objets.</p>
              </div>
            </div>
            <span class="list-card__cta">Voir</span>
          </a>
        <% }) %>
      </div>
    <% } %>

    <% if (total === 0) { %>
      <div class="alert alert-warning text-center">Aucun Pokemon trouve.</div>
    <% } %>

    <% if (totalPages > 1) { %>
      <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination">
          <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/objets?search=<%= encodeURIComponent(search) %>&sort=<%= sort %>&view=<%= view %>&page=<%= page - 1 %>">Precedent</a>
          </li>

          <% const start = Math.max(1, page - 2); const end = Math.min(totalPages, page + 2); %>

          <% for (let i = start; i <= end; i++) { %>
            <li class="page-item <%= i === page ? 'active' : '' %>">
              <a class="page-link" href="/objets?search=<%= encodeURIComponent(search) %>&sort=<%= sort %>&view=<%= view %>&page=<%= i %>"><%= i %></a>
            </li>
          <% } %>

          <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/objets?search=<%= encodeURIComponent(search) %>&sort=<%= sort %>&view=<%= view %>&page=<%= page + 1 %>">Suivant</a>
          </li>
        </ul>
      </nav>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

<script>
const searchInput = document.getElementById('searchInput');
const searchForm = document.getElementById('searchForm');
let typingTimer;

searchInput.addEventListener('input', () => {
  clearTimeout(typingTimer);
  typingTimer = setTimeout(() => {
    const params = new URLSearchParams(new FormData(searchForm));
    window.location.href = '/objets?' + params.toString();
  }, 300);
});

function setSort(value) {
  document.getElementById('sortInput').value = value;
  const params = new URLSearchParams(new FormData(searchForm));
  window.location.href = '/objets?' + params.toString();
}

function setView(value) {
  document.getElementById('viewInput').value = value;
  const params = new URLSearchParams(new FormData(searchForm));
  window.location.href = '/objets?' + params.toString();
}
</script>

<script src="/public/favorites.js"></script>

</body>
</html>
