<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Mes favoris</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/public/style.css">
</head>
<body class="pokedex-bg">

<%- include('partials/header') %>

<div class="container my-5">
  <section class="favorites-hero mb-4">
    <div class="row align-items-center g-4">
      <div class="col-lg-8 text-center text-lg-start">
        <p class="feature-panel__label mb-2">Collection perso</p>
        <h1 class="mb-3">Mes Pokemon favoris</h1>
        <p class="text-muted mb-0">Retrouve ici les Pokemon que tu as gardes de cote pour les revoir rapidement.</p>
      </div>
      <div class="col-lg-4">
        <div class="favorites-stat">
          <span class="favorites-stat__label">Total en favoris</span>
          <strong id="favoritesCount">0</strong>
        </div>
      </div>
    </div>
  </section>

  <section id="emptyMsg" class="favorites-empty d-none">
    <div class="text-center">
      <div class="favorites-empty__icon">?</div>
      <h2 class="h3 mb-3">Aucun favori pour le moment</h2>
      <p class="text-muted mb-4">Ajoute des Pokemon depuis leurs fiches detail pour constituer ta propre selection.</p>
      <a href="/objets" class="btn btn-primary">Explorer le Pokedex</a>
    </div>
  </section>

  <div id="favoritesContainer" class="row g-4"></div>
</div>

<%- include('partials/footer') %>

<script src="/public/favorites.js"></script>
<script src="/public/favorites-page.js"></script>
</body>
</html>
