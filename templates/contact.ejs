<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Contact</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <div class="container my-5">
    <div class="row g-4 align-items-stretch">
      <div class="col-lg-5">
        <div class="pokemon-card h-100">
          <p class="text-uppercase text-muted small mb-2">Contact</p>
          <h1 class="mb-3">Parlons de ton Pokedex</h1>
          <p class="text-muted mb-4">
            Une question, une idee d'amelioration, ou un bug a signaler : utilise ce formulaire.
          </p>

          <div class="d-grid gap-3">
            <div class="contact-info-box">
              <strong>Reponse</strong>
              <div class="text-muted">Sous 24 a 48 heures</div>
            </div>
            <div class="contact-info-box">
              <strong>Projet</strong>
              <div class="text-muted">Node.js, Express, EJS, PokeAPI</div>
            </div>
            <div class="contact-info-box">
              <strong>Objet</strong>
              <div class="text-muted">Questions, retours, nouvelles fonctionnalites</div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-7">
        <div class="pokemon-card h-100">
          <form class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="name">Nom</label>
              <input id="name" class="form-control" placeholder="Ton nom">
            </div>

            <div class="col-md-6">
              <label class="form-label" for="email">Email</label>
              <input id="email" type="email" class="form-control" placeholder="nom@email.com">
            </div>

            <div class="col-12">
              <label class="form-label" for="subject">Sujet</label>
              <input id="subject" class="form-control" placeholder="Ex: idee pour ameliorer le site">
            </div>

            <div class="col-12">
              <label class="form-label" for="message">Message</label>
              <textarea id="message" class="form-control" rows="6" placeholder="Ecris ton message ici"></textarea>
            </div>

            <div class="col-12 d-flex flex-column flex-sm-row gap-2">
              <button class="btn btn-primary" type="submit">Envoyer</button>
              <a class="btn btn-outline-secondary" href="/objets">Retour au Pokedex</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
